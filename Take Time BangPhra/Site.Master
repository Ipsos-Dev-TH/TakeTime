<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Take_Time_BangPhra.SiteMaster" %>
<!DOCTYPE html>

<html lang="th">
<head runat="server">
    <meta name="facebook-domain-verification" content="d4axpewe6d61b6eq8s76f1v2y8zf02" />
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline' 'unsafe-eval'">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <!-- Google Fonts - Prompt (Thai-friendly, centralized font loading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
        
    <style type="text/css">
        /* ============================================
           CENTRALIZED FONT CONFIGURATION
           Change font here to update entire website
           ============================================ */
        body,
        div.ExampleFont,
        .ExampleFont {
            font-family: 'Prompt', sans-serif;
        }

        /* Improved navbar styling - RESTORED ORIGINAL STYLE */
        .navbar {
            background-color: #5D4037 !important;
            border-color: #3E2723 !important;
            min-height: 50px;
            margin-bottom: 0;
        }

        /* Fixed navbar requires body padding */
        body {
            padding-top: 70px;
        }
        
        .navbar-inverse .navbar-nav > li > a {
            color: #F8F4E9 !important;
            padding: 15px 10px;
            white-space: nowrap;
        }
        
        .navbar-inverse .navbar-brand {
            color: #F8F4E9 !important;
            padding: 15px;
        }
        
        .navbar-inverse .navbar-nav > .open > a,
        .navbar-inverse .navbar-nav > .open > a:hover,
        .navbar-inverse .navbar-nav > .open > a:focus {
            background-color: #3E2723 !important;
        }
        
        .navbar-inverse .navbar-toggle {
            border-color: #3E2723 !important;
        }
        
        .navbar-inverse .navbar-toggle:hover,
        .navbar-inverse .navbar-toggle:focus {
            background-color: #3E2723 !important;
        }

        /* Login/Logout button styling */
        .btn-auth {
            border: none;
            border-radius: 25px;
            padding: 8px 20px;
            margin: 10px 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            cursor: pointer;
        }

        .btn-login {
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            color: white !important;
            box-shadow: 0 2px 10px rgba(76, 175, 80, 0.3);
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);
            background: linear-gradient(135deg, #66BB6A, #388E3C);
            color: white !important;
            text-decoration: none;
        }

        .btn-logout {
            background: linear-gradient(135deg, #D32F2F, #B71C1C);
            color: white !important;
            box-shadow: 0 2px 10px rgba(211, 47, 47, 0.3);
        }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.4);
            background: linear-gradient(135deg, #E53935, #C62828);
            color: white !important;
        }

        /* Auth buttons container */
        .auth-buttons {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        /* Admin Menu Styling */
        .admin-menu {
            background: rgba(76, 175, 80, 0.2) !important;
            border-radius: 5px;
            margin: 0 5px;
        }

        .admin-menu > a {
            font-weight: 600 !important;
        }

        .admin-menu .dropdown-menu {
            background: #5D4037;
            border: none;
            min-width: 250px;
        }

        .admin-menu .dropdown-menu > li > a {
            color: #F8F4E9 !important;
            padding: 10px 15px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            font-size: 13px;
        }

        .admin-menu .dropdown-menu > li > a:hover {
            background: #3E2723 !important;
            color: #FFD54F !important;
        }

        /* Owner-only menu items */
        .owner-only {
            background: rgba(255, 193, 7, 0.1) !important;
            border-left: 3px solid #FFC107;
        }

        .owner-only > a {
            color: #FFD54F !important;
        }

        /* ============================================
           MEGA MENU STYLING
           ============================================ */
        .mega-menu {
            position: static !important;
        }

        .mega-menu .mega-dropdown {
            position: absolute;
            left: 0;
            right: 0;
            width: 100%;
            padding: 20px 30px;
            background: linear-gradient(135deg, #5D4037 0%, #4E342E 100%);
            border: none;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.3);
            display: none;
        }

        .mega-menu:hover .mega-dropdown,
        .mega-menu.open .mega-dropdown {
            display: block;
        }

        .mega-menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .mega-menu-column {
            min-width: 200px;
        }

        .mega-menu-column h4 {
            color: #FFD54F;
            font-size: 13px;
            font-weight: 600;
            margin: 0 0 12px 0;
            padding-bottom: 8px;
            border-bottom: 2px solid rgba(255,213,79,0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .mega-menu-column h4 i {
            margin-right: 8px;
        }

        .mega-menu-column ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .mega-menu-column ul li {
            margin-bottom: 4px;
        }

        .mega-menu-column ul li a {
            display: flex;
            align-items: center;
            padding: 8px 12px;
            color: #F8F4E9 !important;
            text-decoration: none;
            border-radius: 6px;
            transition: all 0.2s ease;
            font-size: 13px;
        }

        .mega-menu-column ul li a:hover {
            background: rgba(255,255,255,0.1);
            color: #FFD54F !important;
            transform: translateX(5px);
        }

        .mega-menu-column ul li a i {
            width: 20px;
            margin-right: 10px;
            text-align: center;
            opacity: 0.8;
        }

        .mega-menu-column.owner-section {
            background: rgba(255, 193, 7, 0.1);
            border-radius: 8px;
            padding: 15px;
            border-left: 3px solid #FFC107;
        }

        .mega-menu-column.owner-section h4 {
            color: #FFC107;
        }

        /* Mobile Mega Menu */
        @media (max-width: 1199px) {
            .mega-menu .mega-dropdown {
                position: relative;
                padding: 10px;
                max-height: 60vh;
                overflow-y: auto;
            }

            .mega-menu-grid {
                grid-template-columns: 1fr 1fr;
                gap: 15px;
            }

            .mega-menu-column {
                min-width: auto;
            }
        }

        @media (max-width: 767px) {
            .mega-menu-grid {
                grid-template-columns: 1fr;
            }

            .mega-menu-column {
                margin-bottom: 15px;
            }
        }

        /* Footer Icon Styling - Fixed Size */
        .footer-icons {
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: flex-end;
        }

        .footer-icon {
            display: inline-block;
            width: 35px;
            height: 35px;
            transition: all 0.3s ease;
        }

        .footer-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .footer-icon:hover {
            transform: translateY(-2px);
        }

        /* Phone icon smaller but same container */
        .footer-icon.phone img {
            padding: 7px;
        }
        
        /* Improved responsive behavior - RESTORED ORIGINAL BURGER MENU */
        @media (max-width: 1199px) {
            .navbar-header {
                float: none;
            }
            .navbar-left, .navbar-right {
                float: none !important;
            }
            .navbar-toggle {
                display: block;
            }
            .navbar-collapse {
                border-top: 1px solid transparent;
                box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
            }
            .navbar-fixed-top {
                top: 0;
                border-width: 0 0 1px;
            }
            .navbar-collapse.collapse {
                display: none!important;
            }
            .navbar-nav {
                float: none!important;
                margin-top: 7.5px;
            }
            .navbar-nav>li {
                float: none;
            }
            .navbar-nav>li>a {
                padding-top: 10px;
                padding-bottom: 10px;
            }
            .collapse.in {
                display: block !important;
            }
            
            /* Mobile padding adjustments */
            body {
                padding-left: 10px !important;
                padding-right: 10px !important;
            }

            .auth-buttons {
                justify-content: center;
                margin: 10px 0;
            }

            .btn-auth {
                margin: 5px;
                width: calc(100% - 30px);
            }

            .admin-menu {
                margin: 5px 0;
                border-radius: 0;
            }

            .footer-icons {
                justify-content: center;
                margin-top: 10px;
            }
        }

        @media (min-width: 1200px) {
            /* Keep menu items in same line on desktop */
            .navbar-nav > li {
                display: inline-block;
                float: none;
            }
        }
        
        /* Adjust container width */
        .container {
            width: 95%;
            padding-left:10px !important;
            padding-right:10px !important;
        }
        
        /* Footer adjustments */
        footer {
            margin-top: 20px;
        }
    </style>

  
</head>

<body>
    <script>
        // Global setHourglass function - safe for all pages
        function setHourglass() {
            try {
                document.body.style.cursor = 'wait';
                // Try to disable submit buttons to prevent double-click
                var submitBtns = document.querySelectorAll('input[type="submit"], button[type="submit"]');
                for (var i = 0; i < submitBtns.length; i++) {
                    submitBtns[i].disabled = true;
                }
            } catch (e) {
                // Silently ignore errors
            }
        }
    </script>
    <script src="../Scripts/AutoComplete.js"></script>
