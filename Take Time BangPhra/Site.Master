        <!-- Global Chat Notification System (for logged-in admin users) -->
        <asp:Panel ID="pnlChatNotification" runat="server" Visible="false">
            <!-- Server-side: query DB for initial unread count (runs on every page load for logged-in users) -->
            <%
            int __chatInit = 0;
            try {
                string __connInit = System.Configuration.ConfigurationManager.ConnectionStrings["TaketimeConnectionString"].ConnectionString;
                Take_Time_BangPhra.code __dbInit = new Take_Time_BangPhra.code();
                System.Data.DataTable __dtInit = __dbInit.DatabaseQuerySafe(__connInit,
                    "SELECT COUNT(*) AS Cnt FROM Guest_Chat WHERE IsFromGuest = 1 AND (Is_Read = 0 OR Is_Read IS NULL)", null);
                if (__dtInit != null && __dtInit.Rows.Count > 0) {
                    __chatInit = Convert.ToInt32(__dtInit.Rows[0]["Cnt"]);
                }
            } catch {}
            %>
            <script>var _ttInitChatCount = <%= __chatInit %>;</script>
            <style>
                /* Chat Alert Overlay - fullscreen centered modal */
                .global-chat-alert {
                    display: none !important;
                    position: fixed !important;
                    top: 0 !important;
                    left: 0 !important;
                    width: 100vw !important;
                    height: 100vh !important;
                    background: rgba(0,0,0,0.85) !important;
                    z-index: 2147483647 !important;
                    align-items: center !important;
                    justify-content: center !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }

                .global-chat-alert.show {
                    display: flex !important;
                }

                .chat-alert-box {
                    background: white;
                    padding: 40px 50px;
                    border-radius: 24px;
                    text-align: center;
                    animation: alertPulse 1.5s ease infinite;
                    width: 90%;
                    max-width: 480px;
                    box-shadow: 0 25px 80px rgba(0,0,0,0.5);
                    position: relative;
                }

                @keyframes alertPulse {
                    0%, 100% { transform: scale(1); box-shadow: 0 25px 80px rgba(0,0,0,0.5); }
                    50% { transform: scale(1.03); box-shadow: 0 30px 100px rgba(244, 67, 54, 0.4); }
                }

                .chat-alert-box .alert-icon {
                    font-size: 70px;
                    color: #f44336;
                    margin-bottom: 15px;
                    animation: alertBlink 0.8s ease-in-out infinite;
                    display: block;
                }

                @keyframes alertBlink {
                    0%, 100% { opacity: 1; transform: scale(1); }
                    50% { opacity: 0.4; transform: scale(1.1); }
                }

                .chat-alert-box h3 {
                    margin: 0 0 10px 0;
                    color: #d32f2f;
                    font-size: 26px;
                    font-weight: 700;
                }

                .chat-alert-box p {
                    margin: 0 0 18px 0;
                    color: #666;
                    font-size: 16px;
                }

                .chat-alert-box .alert-room-info {
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    color: white;
                    padding: 15px 20px;
                    border-radius: 12px;
                    margin-bottom: 20px;
                }

                .chat-alert-box .alert-room-info .room-name {
                    font-size: 20px;
                    font-weight: 700;
                    margin-bottom: 5px;
                }

                .chat-alert-box .alert-room-info .guest-name {
                    font-size: 14px;
                    opacity: 0.9;
                }

                .chat-alert-box .alert-message-preview {
                    background: #f5f5f5;
                    padding: 12px 15px;
                    border-radius: 10px;
                    margin-bottom: 20px;
                    text-align: left;
                    font-size: 14px;
                    color: #333;
                    max-height: 80px;
                    overflow: hidden;
                }

                .chat-alert-box .btn-respond-chat {
                    background: linear-gradient(135deg, #4CAF50, #388E3C);
                    color: white;
                    border: none;
                    padding: 14px 35px;
                    border-radius: 25px;
                    font-size: 16px;
                    font-weight: 600;
                    cursor: pointer;
                    text-decoration: none;
                    display: inline-block;
                    transition: all 0.3s ease;
                }

                .chat-alert-box .btn-respond-chat:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 20px rgba(76, 175, 80, 0.4);
                    color: white;
                    text-decoration: none;
                }

                .chat-alert-box .btn-dismiss {
                    background: #e0e0e0;
                    color: #666;
                    border: none;
                    padding: 10px 25px;
                    border-radius: 20px;
                    font-size: 14px;
                    cursor: pointer;
                    margin-left: 10px;
                    transition: all 0.3s ease;
                }

                .chat-alert-box .btn-dismiss:hover {
                    background: #bdbdbd;
                }

                /* Floating Chat Badge */
                .chat-notification-badge {
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    background: #757575;
                    color: white;
                    padding: 12px;
                    border-radius: 50%;
                    display: none;
                    align-items: center;
                    justify-content: center;
                    gap: 0;
                    cursor: pointer;
                    z-index: 9998;
                    box-shadow: 0 3px 12px rgba(0,0,0,0.2);
                    text-decoration: none;
                    transition: all 0.3s ease;
                    width: 48px;
                    height: 48px;
                }

                .chat-notification-badge:hover {
                    color: white;
                    text-decoration: none;
                    transform: scale(1.1);
                    box-shadow: 0 5px 20px rgba(0,0,0,0.3);
                }

                .chat-notification-badge.show {
                    display: flex;
                }

                /* When has unread messages - expand and pulse */
                .chat-notification-badge.has-unread {
                    background: linear-gradient(135deg, #f44336, #c62828);
                    padding: 12px 20px;
                    border-radius: 50px;
                    width: auto;
                    height: auto;
                    gap: 8px;
                    animation: badgePulse 2s infinite;
                    box-shadow: 0 5px 25px rgba(244, 67, 54, 0.4);
                }

                .chat-notification-badge .badge-text,
                .chat-notification-badge .count {
                    display: none;
                }

                .chat-notification-badge.has-unread .badge-text,
                .chat-notification-badge.has-unread .count {
                    display: inline;
                }

                @keyframes badgePulse {
                    0%, 100% { box-shadow: 0 5px 25px rgba(244, 67, 54, 0.4); }
                    50% { box-shadow: 0 5px 35px rgba(244, 67, 54, 0.6); }
                }

                .chat-notification-badge i {
                    font-size: 20px;
                }

                .chat-notification-badge .count {
                    background: white;
                    color: #f44336;
                    padding: 2px 8px;
                    border-radius: 10px;
                    font-weight: 700;
                    font-size: 14px;
                }

                /* Room Service badge unread state */
                .room-service-badge {
                    background: #757575;
                }

                .room-service-badge.has-unread {
                    background: linear-gradient(135deg, #ff9800, #f57c00) !important;
                    box-shadow: 0 5px 25px rgba(255, 152, 0, 0.4);
                }

                .room-service-badge.has-unread .count {
                    color: #f57c00;
                }
            </style>

            <!-- Chat Alert Overlay -->
            <div class="global-chat-alert" id="globalChatAlert">
                <div class="chat-alert-box">
                    <i class="fas fa-comments alert-icon"></i>
                    <h3>ข้อความใหม่จากแขก!</h3>
                    <p>กรุณาตอบกลับโดยเร็ว</p>
                    <div class="alert-room-info">
                        <div class="room-name" id="alertRoomName">-</div>
                        <div class="guest-name" id="alertGuestName">-</div>
                    </div>
                    <div class="alert-message-preview" id="alertMessagePreview">
                        -
                    </div>
                    <div class="alert-count-info" id="alertCountInfo" style="font-size:13px;color:#999;margin-bottom:15px;">
                    </div>
                    <div>
                        <a href="<%= ResolveUrl("~/Admin/Chat/ChatManagement") %>" class="btn-respond-chat">
                            <i class="fas fa-reply"></i> ตอบกลับทันที
                        </a>
                        <button type="button" class="btn-dismiss" onclick="dismissChatAlert()">
                            ปิดชั่วคราว (5 นาที)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Room Service Alert Overlay -->
            <div class="global-chat-alert" id="globalRSAlert">
                <div class="chat-alert-box" style="animation: none;">
                    <i class="fas fa-concierge-bell alert-icon" style="color: #ff9800;"></i>
                    <h3>ออเดอร์ Room Service ใหม่!</h3>
                    <p>กรุณารับออเดอร์โดยเร็ว</p>
                    <div class="alert-room-info" style="background: linear-gradient(135deg, #ff9800, #f57c00);">
                        <div class="room-name" id="rsAlertRoomName">-</div>
                        <div class="guest-name" id="rsAlertGuestName">-</div>
                    </div>
                    <div class="alert-message-preview" id="rsAlertPreview">
                        -
                    </div>
                    <div class="alert-count-info" id="rsAlertCountInfo" style="font-size:13px;color:#999;margin-bottom:15px;">
                    </div>
                    <div>
                        <a href="<%= ResolveUrl("~/Admin/RoomService/OrderManagement") %>" class="btn-respond-chat" style="background: linear-gradient(135deg, #ff9800, #f57c00);">
                            <i class="fas fa-concierge-bell"></i> ดูออเดอร์ทันที
                        </a>
                        <button type="button" class="btn-dismiss" onclick="dismissRSAlert()">
                            ปิดชั่วคราว (5 นาที)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Floating Badge - Chat (always visible as shortcut, expands when has messages) -->
            <a href="<%= ResolveUrl("~/Admin/Chat/ChatManagement") %>" class="chat-notification-badge" id="chatNotificationBadge">
                <i class="fas fa-comments"></i>
                <span class="badge-text">แชทใหม่</span>
                <span class="count" id="chatUnreadCount">0</span>
            </a>

            <!-- Floating Badge - Room Service (only shows when has pending orders) -->
            <a href="<%= ResolveUrl("~/Admin/RoomService/OrderManagement") %>" class="chat-notification-badge room-service-badge" id="roomServiceBadge" style="bottom: 80px;">
                <i class="fas fa-concierge-bell"></i>
                <span class="badge-text">ออเดอร์ใหม่</span>
                <span class="count" id="rsUnreadCount">0</span>
            </a>

            <!-- Audio for notification -->
            <audio id="globalNotificationSound" preload="auto">
                <source src="data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1sbJaQo5N6YWJ0lJOUlH50ZnKJhZqWlYN0Znd3e4KDmJmXjHlxe3p6f4GGiouJhYB8e35+gIOGiYuKiIaCgYGCgYOFhoaFhYSDgoKCgoKDg4ODg4OCgoKCgoKCgoKCgoKCgoKCgoKCgoKC" type="audio/wav">
            </audio>

            <script>
                // =============================================
                // Global Notification System
                // Chat + Room Service + Persistent Alerts
                // =============================================
                var chatSoundInterval = null;
                var chatCheckInterval = null;
                var rsCheckInterval = null;
                var sessionKeepAliveInterval = null;

                // --- sessionStorage helpers for dismiss state (persists across page navigation) ---
                function getDismissedUntil(key) {
                    try {
                        var val = sessionStorage.getItem(key);
                        return val ? parseInt(val) : 0;
                    } catch(e) { return 0; }
                }
                function setDismissedUntil(key, time) {
                    try { sessionStorage.setItem(key, time.toString()); } catch(e) {}
                }
                function clearDismissedUntil(key) {
                    try { sessionStorage.removeItem(key); } catch(e) {}
                }

                // =============================================
                // CHAT NOTIFICATIONS
                // =============================================
                function checkGlobalChatMessages() {
                    // Skip if currently on ChatManagement page (it has its own UI)
                    if (window.location.href.indexOf('ChatManagement') > -1) {
                        return;
                    }

                    fetch('<%= ResolveUrl("~/Admin/NotificationCheck") %>?action=chat&_=' + new Date().getTime())
                    .then(function(response) {
                        if (!response.ok) { console.log('[TakeTime] Chat API status:', response.status); }
                        return response.json();
                    })
                    .then(function(data) {
                        console.log('[TakeTime] Chat response:', JSON.stringify(data));
                        if (data && data.hasUnread && data.count > 0) {
                            var count = data.count;

                            // Update floating badge - expand to show count
                            var badge = document.getElementById('chatNotificationBadge');
                            var countEl = document.getElementById('chatUnreadCount');
                            if (badge) {
                                badge.classList.add('has-unread');
                                if (countEl) countEl.innerText = count;
                            }

                            // Show modal alert if:
                            // 1. Not currently dismissed (dismiss timer not active)
                            // 2. Alert not already showing
                            var now = new Date().getTime();
                            var dismissedUntil = getDismissedUntil('chatDismissedUntil');
                            var alertEl = document.getElementById('globalChatAlert');
                            var isShowing = alertEl && alertEl.classList.contains('show');

                            if (!isShowing && now > dismissedUntil) {
                                // Show alert with latest message info
                                showChatAlert(
                                    data.latestRoom || '-',
                                    data.latestGuest || '-',
                                    data.latestMessage || 'ข้อความใหม่',
                                    count
                                );
                            } else if (isShowing) {
                                // Update displayed info if already showing
                                document.getElementById('alertRoomName').innerText = data.latestRoom || '-';
                                document.getElementById('alertGuestName').innerText = data.latestGuest || '-';
                                document.getElementById('alertMessagePreview').innerText = data.latestMessage || '-';
                                var countInfo = document.getElementById('alertCountInfo');
                                if (countInfo) {
                                    countInfo.innerText = count > 1 ? ('รวม ' + count + ' ข้อความที่ยังไม่ได้อ่าน') : '';
                                }
                            }
                        } else {
                            // No unread messages - keep badge as subtle shortcut
                            var badge = document.getElementById('chatNotificationBadge');
                            if (badge) badge.classList.remove('has-unread');
                            hideChatAlert();
                            clearDismissedUntil('chatDismissedUntil');
                        }
                    })
                    .catch(function(err) {
                        console.log('[TakeTime] Chat check error:', err);
                        // Show error state on badge so user knows API is failing
                        var badge = document.getElementById('chatNotificationBadge');
                        if (badge) {
                            badge.style.background = '#FF9800';
                            badge.title = 'API Error: ' + err;
                        }
                    });
                }

                function showChatAlert(roomName, guestName, message, count) {
                    try {
                        var el;
                        el = document.getElementById('alertRoomName');
                        if (el) el.innerText = roomName;
                        el = document.getElementById('alertGuestName');
                        if (el) el.innerText = guestName;
                        el = document.getElementById('alertMessagePreview');
                        if (el) el.innerText = message;
                        var countInfo = document.getElementById('alertCountInfo');
                        if (countInfo) {
                            countInfo.innerText = count > 1 ? ('รวม ' + count + ' ข้อความที่ยังไม่ได้อ่าน') : '';
                        }

                        // Force show with inline styles (bypass any CSS override issues)
                        var alertEl = document.getElementById('globalChatAlert');
                        if (alertEl) {
                            alertEl.style.cssText = 'display:flex !important;position:fixed !important;top:0 !important;left:0 !important;width:100vw !important;height:100vh !important;background:rgba(0,0,0,0.85) !important;z-index:2147483647 !important;align-items:center !important;justify-content:center !important;margin:0 !important;padding:0 !important;';
                            alertEl.classList.add('show');
                        }

                        // Play notification sound
                        playNotificationSound();
                        // Repeat sound every 3 seconds while alert is showing
                        if (!chatSoundInterval) {
                            chatSoundInterval = setInterval(function() {
                                var a = document.getElementById('globalChatAlert');
                                if (a && a.classList.contains('show')) {
                                    playNotificationSound();
                                } else {
                                    clearInterval(chatSoundInterval);
                                    chatSoundInterval = null;
                                }
                            }, 3000);
                        }
                    } catch(e) { console.log('showChatAlert error:', e); }
                }

                function hideChatAlert() {
                    var alertEl = document.getElementById('globalChatAlert');
                    if (alertEl) {
                        alertEl.style.cssText = '';
                        alertEl.classList.remove('show');
                    }
                    if (chatSoundInterval) {
                        clearInterval(chatSoundInterval);
                        chatSoundInterval = null;
                    }
                }

                function dismissChatAlert() {
                    hideChatAlert();
                    // Dismiss for 5 minutes - stored in sessionStorage so survives page navigation
                    var dismissUntil = new Date().getTime() + (5 * 60 * 1000);
                    setDismissedUntil('chatDismissedUntil', dismissUntil);
                }

                // =============================================
                // ROOM SERVICE NOTIFICATIONS
                // =============================================
                var rsSoundInterval = null;

                function checkRoomServiceOrders() {
                    // Skip if currently on OrderManagement page
                    if (window.location.href.indexOf('OrderManagement') > -1) {
                        return;
                    }

                    fetch('<%= ResolveUrl("~/Admin/NotificationCheck") %>?action=rs&_=' + new Date().getTime())
                    .then(function(response) { return response.json(); })
                    .then(function(data) {
                        if (data && data.success && data.orders && data.orders.length > 0) {
                            var orders = data.orders;
                            var count = orders.length;
                            var latest = orders[0]; // Most recent pending order

                            // Show and expand room service badge
                            var badge = document.getElementById('roomServiceBadge');
                            var countEl = document.getElementById('rsUnreadCount');
                            if (badge) {
                                badge.classList.add('show');
                                badge.classList.add('has-unread');
                                if (countEl) countEl.innerText = count;
                            }

                            // Show modal alert if not dismissed and not already showing
                            var now = new Date().getTime();
                            var dismissedUntil = getDismissedUntil('rsDismissedUntil');
                            var alertEl = document.getElementById('globalRSAlert');
                            var isShowing = alertEl && alertEl.classList.contains('show');

                            if (!isShowing && now > dismissedUntil) {
                                showRSAlert(
                                    latest.roomName || '-',
                                    latest.guestName || '-',
                                    (latest.itemsPreview || '-') + ' (฿' + (latest.totalAmount || '0') + ')',
                                    count
                                );
                            } else if (isShowing) {
                                // Update displayed info
                                document.getElementById('rsAlertRoomName').innerText = latest.roomName || '-';
                                document.getElementById('rsAlertGuestName').innerText = latest.guestName || '-';
                                document.getElementById('rsAlertPreview').innerText = (latest.itemsPreview || '-') + ' (฿' + (latest.totalAmount || '0') + ')';
                                var countInfo = document.getElementById('rsAlertCountInfo');
                                if (countInfo) {
                                    countInfo.innerText = count > 1 ? ('รวม ' + count + ' ออเดอร์ที่รอดำเนินการ') : '';
                                }
                            }
                        } else {
                            // No pending orders - hide RS badge
                            var badge = document.getElementById('roomServiceBadge');
                            if (badge) {
                                badge.classList.remove('show');
                                badge.classList.remove('has-unread');
                            }
                            hideRSAlert();
                            clearDismissedUntil('rsDismissedUntil');
                        }
                    })
                    .catch(function(err) { console.log('RS check error:', err); });
                }

                function showRSAlert(roomName, guestName, preview, count) {
                    try {
                        var el;
                        el = document.getElementById('rsAlertRoomName');
                        if (el) el.innerText = roomName;
                        el = document.getElementById('rsAlertGuestName');
                        if (el) el.innerText = guestName;
                        el = document.getElementById('rsAlertPreview');
                        if (el) el.innerText = preview;
                        var countInfo = document.getElementById('rsAlertCountInfo');
                        if (countInfo) {
                            countInfo.innerText = count > 1 ? ('รวม ' + count + ' ออเดอร์ที่รอดำเนินการ') : '';
                        }

                        var alertEl = document.getElementById('globalRSAlert');
                        if (alertEl) {
                            alertEl.style.cssText = 'display:flex !important;position:fixed !important;top:0 !important;left:0 !important;width:100vw !important;height:100vh !important;background:rgba(0,0,0,0.85) !important;z-index:2147483647 !important;align-items:center !important;justify-content:center !important;margin:0 !important;padding:0 !important;';
                            alertEl.classList.add('show');
                        }

                        playNotificationSound();
                        if (!rsSoundInterval) {
                            rsSoundInterval = setInterval(function() {
                                var a = document.getElementById('globalRSAlert');
                                if (a && a.classList.contains('show')) {
                                    playNotificationSound();
                                } else {
                                    clearInterval(rsSoundInterval);
                                    rsSoundInterval = null;
                                }
                            }, 5000);
                        }
                    } catch(e) { console.log('showRSAlert error:', e); }
                }

                function hideRSAlert() {
                    var alertEl = document.getElementById('globalRSAlert');
                    if (alertEl) {
                        alertEl.style.cssText = '';
                        alertEl.classList.remove('show');
                    }
                    if (rsSoundInterval) {
                        clearInterval(rsSoundInterval);
                        rsSoundInterval = null;
                    }
                }

                function dismissRSAlert() {
                    hideRSAlert();
                    var dismissUntil = new Date().getTime() + (5 * 60 * 1000);
                    setDismissedUntil('rsDismissedUntil', dismissUntil);
                }

                // =============================================
                // SHARED: Sound + Session Keep-Alive
                // =============================================
                function playNotificationSound() {
                    try {
                        var audio = document.getElementById('globalNotificationSound');
                        if (audio) {
                            audio.currentTime = 0;
                            audio.play().catch(function(e) {});
                        }
                    } catch(e) {}
                }

                // keepSessionAlive: not needed as a separate function
                // Every 5-second poll to NotificationCheck.aspx automatically extends the ASP.NET session

                // =============================================
                // INITIALIZE
                // =============================================
                document.addEventListener('DOMContentLoaded', function() {
                    // Move alert overlays to document.body to avoid parent CSS interference
                    // (position:fixed can break inside transformed/overflow-hidden parents)
                    var chatAlert = document.getElementById('globalChatAlert');
                    var rsAlert = document.getElementById('globalRSAlert');
                    var chatBadge = document.getElementById('chatNotificationBadge');
                    var rsBadge = document.getElementById('roomServiceBadge');
                    if (chatAlert) document.body.appendChild(chatAlert);
                    if (rsAlert) document.body.appendChild(rsAlert);
                    if (chatBadge) document.body.appendChild(chatBadge);
                    if (rsBadge) document.body.appendChild(rsBadge);

                    // Always show chat badge (as quick-access shortcut to chat page)
                    if (chatBadge) {
                        chatBadge.classList.add('show');
                    }

                    // Apply server-side initial data immediately (no waiting for first API call)
                    if (typeof _ttInitChatCount !== 'undefined' && _ttInitChatCount > 0) {
                        if (chatBadge) {
                            chatBadge.classList.add('has-unread');
                            var countEl = document.getElementById('chatUnreadCount');
                            if (countEl) countEl.innerText = _ttInitChatCount;
                        }
                        console.log('[TakeTime] Server-side initial chat count: ' + _ttInitChatCount);
                    }

                    console.log('[TakeTime Notification] System initialized, polling started');

                    // Check immediately on page load (will also extend session)
                    checkGlobalChatMessages();
                    checkRoomServiceOrders();

                    // Then check every 5 seconds
                    // Each poll extends the ASP.NET session (.aspx page has session by default)
                    // so session never expires while browser is open
                    chatCheckInterval = setInterval(checkGlobalChatMessages, 5000);
                    rsCheckInterval = setInterval(checkRoomServiceOrders, 5000);
                });

                // Cleanup on page unload
                window.addEventListener('beforeunload', function() {
                    if (chatCheckInterval) clearInterval(chatCheckInterval);
                    if (chatSoundInterval) clearInterval(chatSoundInterval);
                    if (rsCheckInterval) clearInterval(rsCheckInterval);
                    if (rsSoundInterval) clearInterval(rsSoundInterval);
                    // sessionKeepAliveInterval removed - chat polling handles session keep-alive
                });
            </script>
        </asp:Panel>
    </form>
</body>
</html>