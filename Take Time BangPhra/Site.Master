<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Take_Time_BangPhra.SiteMaster" %>
<!DOCTYPE html>

<html lang="th">
<head runat="server">
    <meta name="facebook-domain-verification" content="d4axpewe6d61b6eq8s76f1v2y8zf02" />
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' https://cdnjs.cloudflare.com 'unsafe-inline' 'unsafe-eval'">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <!-- Google Fonts - Prompt (Thai-friendly, centralized font loading) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
        
    <style type="text/css">
        /* ============================================
           CENTRALIZED FONT CONFIGURATION
           Change font here to update entire website
           ============================================ */
        body,
        div.ExampleFont,
        .ExampleFont {
            font-family: 'Prompt', sans-serif;
        }

        /* Improved navbar styling - RESTORED ORIGINAL STYLE */
        .navbar {
            background-color: #5D4037 !important;
            border-color: #3E2723 !important;
            min-height: 50px;
            margin-bottom: 20px;
        }
        
        .navbar-inverse .navbar-nav > li > a {
            color: #F8F4E9 !important;
            padding: 15px 10px;
            white-space: nowrap;
        }
        
        .navbar-inverse .navbar-brand {
            color: #F8F4E9 !important;
            padding: 15px;
        }
        
        .navbar-inverse .navbar-nav > .open > a,
        .navbar-inverse .navbar-nav > .open > a:hover,
        .navbar-inverse .navbar-nav > .open > a:focus {
            background-color: #3E2723 !important;
        }
        
        .navbar-inverse .navbar-toggle {
            border-color: #3E2723 !important;
        }
        
        .navbar-inverse .navbar-toggle:hover,
        .navbar-inverse .navbar-toggle:focus {
            background-color: #3E2723 !important;
        }

        /* Login/Logout button styling */
        .btn-auth {
            border: none;
            border-radius: 25px;
            padding: 8px 20px;
            margin: 10px 15px;
            font-weight: 500;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            text-align: center;
            cursor: pointer;
        }

        .btn-login {
            background: linear-gradient(135deg, #4CAF50, #2E7D32);
            color: white !important;
            box-shadow: 0 2px 10px rgba(76, 175, 80, 0.3);
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(76, 175, 80, 0.4);
            background: linear-gradient(135deg, #66BB6A, #388E3C);
            color: white !important;
            text-decoration: none;
        }

        .btn-logout {
            background: linear-gradient(135deg, #D32F2F, #B71C1C);
            color: white !important;
            box-shadow: 0 2px 10px rgba(211, 47, 47, 0.3);
        }

        .btn-logout:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(211, 47, 47, 0.4);
            background: linear-gradient(135deg, #E53935, #C62828);
            color: white !important;
        }

        /* Auth buttons container */
        .auth-buttons {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        /* Admin Menu Styling */
        .admin-menu {
            background: rgba(76, 175, 80, 0.2) !important;
            border-radius: 5px;
            margin: 0 5px;
        }

        .admin-menu > a {
            font-weight: 600 !important;
        }

        .admin-menu .dropdown-menu {
            background: #5D4037;
            border: none;
            min-width: 250px;
        }

        .admin-menu .dropdown-menu > li > a {
            color: #F8F4E9 !important;
            padding: 10px 15px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            font-size: 13px;
        }

        .admin-menu .dropdown-menu > li > a:hover {
            background: #3E2723 !important;
            color: #FFD54F !important;
        }

        /* Owner-only menu items */
        .owner-only {
            background: rgba(255, 193, 7, 0.1) !important;
            border-left: 3px solid #FFC107;
        }

        .owner-only > a {
            color: #FFD54F !important;
        }

        /* Footer Icon Styling - Fixed Size */
        .footer-icons {
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: flex-end;
        }

        .footer-icon {
            display: inline-block;
            width: 35px;
            height: 35px;
            transition: all 0.3s ease;
        }

        .footer-icon img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .footer-icon:hover {
            transform: translateY(-2px);
        }

        /* Phone icon smaller but same container */
        .footer-icon.phone img {
            padding: 7px;
        }
        
        /* Improved responsive behavior - RESTORED ORIGINAL BURGER MENU */
        @media (max-width: 1199px) {
            .navbar-header {
                float: none;
            }
            .navbar-left, .navbar-right {
                float: none !important;
            }
            .navbar-toggle {
                display: block;
            }
            .navbar-collapse {
                border-top: 1px solid transparent;
                box-shadow: inset 0 1px 0 rgba(255,255,255,0.1);
            }
            .navbar-fixed-top {
                top: 0;
                border-width: 0 0 1px;
            }
            .navbar-collapse.collapse {
                display: none!important;
            }
            .navbar-nav {
                float: none!important;
                margin-top: 7.5px;
            }
            .navbar-nav>li {
                float: none;
            }
            .navbar-nav>li>a {
                padding-top: 10px;
                padding-bottom: 10px;
            }
            .collapse.in {
                display: block !important;
            }
            
            /* Prevent navbar from covering content */
            body {
                padding-top: 70px;
                padding-left:10px !important;
                padding-right:10px !important;
            }

            .auth-buttons {
                justify-content: center;
                margin: 10px 0;
            }

            .btn-auth {
                margin: 5px;
                width: calc(100% - 30px);
            }

            .admin-menu {
                margin: 5px 0;
                border-radius: 0;
            }

            .footer-icons {
                justify-content: center;
                margin-top: 10px;
            }
        }

        @media (min-width: 1200px) {
            /* Keep menu items in same line on desktop */
            .navbar-nav > li {
                display: inline-block;
                float: none;
            }
        }
        
        /* Adjust container width */
        .container {
            width: 95%;
            padding-left:10px !important;
            padding-right:10px !important;
        }
        
        /* Footer adjustments */
        footer {
            margin-top: 20px;
        }
    </style>

  
</head>

<body onbeforeunload="setHourglass();" onunload="setHourglass();">
           
