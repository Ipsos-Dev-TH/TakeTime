                                                        <i class="fas fa-user-tie"></i> จัดการพนักงาน
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/HR/SupervisorManagement">
                                                        <i class="fas fa-users-cog"></i> จัดการหัวหน้า-ลูกน้อง
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/Leave/LeaveManagement">
                                                        <i class="fas fa-calendar-minus"></i> จัดการการลา
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/Leave/SupervisorLeaveApproval">
                                                        <i class="fas fa-user-check"></i> อนุมัติการลา (ทั้งหมด)
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/Payroll/PayrollManagement">
                                                        <i class="fas fa-money-check-alt"></i> เงินเดือน/OT
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/HR/OTManagement">
                                                        <i class="fas fa-list-alt"></i> จัดการ OT ทั้งหมด
                                                    </a></li>
                                                    <li role="separator" style="border-top: 1px solid rgba(255,193,7,0.3); margin: 8px 0;"></li>
                                                    <li><a runat="server" href="~/Admin/Assets/AssetManagement">
                                                        <i class="fas fa-boxes"></i> สินทรัพย์
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/Vendor">
                                                        <i class="fas fa-store"></i> Vendor
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/AffiliateManagement">
                                                        <i class="fas fa-handshake"></i> จัดการ Affiliate
                                                    </a></li>
                                                    <li><a runat="server" href="~/Admin/WebAnalytics">
                                                        <i class="fas fa-chart-line"></i> Web Analytics
                                                    </a></li>
                                                </ul>
                                            </div>
                                        </asp:Panel>
                                    </div>
                                </div>
                            </li>
                        </asp:PlaceHolder>
                        <!-- Employee Menu (visible to all logged-in users) -->
                        <asp:PlaceHolder ID="pnlEmployeeNav" runat="server" Visible="false">
                            <li class="dropdown">
                                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" style="background: rgba(102, 126, 234, 0.2); border-radius: 5px;">
                                    <i class="fas fa-user-circle"></i> พนักงาน <span class="caret"></span>
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a runat="server" href="~/Admin/Leave/LeaveRequest">
                                        <i class="fas fa-calendar-minus"></i> ขอลางาน
                                    </a></li>
                                    <li><a runat="server" href="~/Admin/Leave/LeaveHistory">
                                        <i class="fas fa-history"></i> ประวัติการลา
                                    </a></li>
                                    <li><a runat="server" href="~/Admin/Leave/SupervisorLeaveApproval">
                                        <i class="fas fa-user-check"></i> อนุมัติการลา (ลูกน้อง)
                                    </a></li>
                                    <li role="separator" class="divider"></li>
                                    <li><a runat="server" href="~/Admin/HR/OTEntry">
                                        <i class="fas fa-clock"></i> บันทึกชั่วโมง OT
                                    </a></li>
                                </ul>
                            </li>
                        </asp:PlaceHolder>
                    </ul>

                    <!-- Authentication Buttons -->
                    <div class="auth-buttons">
                        <!-- Login Button (Visible when not logged in) -->
                        <asp:HyperLink ID="hlLogin" runat="server" 
                            NavigateUrl="~/Admin/Login" 
                            CssClass="btn-auth btn-login"
                            Visible="false">
                            <i class="fas fa-sign-in-alt"></i> ผู้ดูแลระบบ
                        </asp:HyperLink>
                        
                        <!-- Logout Button (Visible when logged in) -->
                        <asp:Button ID="btnLogout" runat="server" 
                            Text="ออกจากระบบ" 
                            CssClass="btn-auth btn-logout" 
                            Visible="false" 
                            OnClick="btnLogout_Click" />
                    </div>
                </div>
            </div>
        </div>
        <div class="container body-content" >
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <table style="width: 100%;">
                    <tr>
                        <td style="text-align:left;width:30%;"> 
                            <p>&copy; <%: DateTime.Now.Year %> - Take Time Bangphra</p>
                        </td>
                        <td style="width:70%;">
                            <div class="footer-icons">
                                <a href="https://www.facebook.com/TakeTimeNatureResort" target="_blank" class="footer-icon">
                                    <img src="../Images/Icon/Facebook.png" alt="Facebook" />
                                </a>
                                <a href="https://lin.ee/U8N29MP" target="_blank" class="footer-icon">
                                    <img src="../Images/Icon/Line.png" alt="Line" />
                                </a>
                                <a href="https://www.tiktok.com/@taketimenatureresort" target="_blank" class="footer-icon">
                                    <img src="../Images/Icon/Tiktok.png" alt="TikTok" />
                                </a>
                                <a href="https://www.google.com/travel/hotels/entity/CgsIsoLIgrCxpI6cARAB/reviews" target="_blank" class="footer-icon">
                                    <img src="../Images/Icon/Google.png" alt="Google" />
                                </a>
                                <a href="https://goo.gl/maps/LxkDCfBkEyFe7dXi8" target="_blank" class="footer-icon">
                                    <img src="../Images/Icon/Maps.png" alt="Maps" />
                                </a>
                                <a href="tel:0634161496" class="footer-icon phone">
                                    <img src="../Images/Icon/Phone.png" alt="Phone" />
                                </a>
                            </div>
                        </td>
                    </tr>
                </table>
            </footer>
        </div>
        </div>

        <!-- Global Chat Notification System (for logged-in admin users) -->
        <asp:Panel ID="pnlChatNotification" runat="server" Visible="false">
            <style>
                /* Chat Alert Overlay */
                .global-chat-alert {
                    display: none;
                    position: fixed;
                    top: 0;
                    left: 0;
                    right: 0;
                    bottom: 0;
                    background: rgba(0,0,0,0.8);
                    z-index: 99999;
                    align-items: center;
                    justify-content: center;
                }

                .global-chat-alert.show {
                    display: flex;
                }

                .chat-alert-box {
                    background: white;
                    padding: 35px 45px;
                    border-radius: 20px;
                    text-align: center;
                    animation: alertShake 0.5s ease infinite;
                    max-width: 450px;
                    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
                }

                @keyframes alertShake {
                    0%, 100% { transform: scale(1); }
                    50% { transform: scale(1.02); }
                }

                .chat-alert-box .alert-icon {
                    font-size: 60px;
                    color: #f44336;
                    margin-bottom: 15px;
                    animation: alertBlink 0.5s infinite;
                }

                @keyframes alertBlink {
                    0%, 100% { opacity: 1; }
                    50% { opacity: 0.3; }
                }

                .chat-alert-box h3 {
                    margin: 0 0 10px 0;
                    color: #333;
                    font-size: 24px;
                }

                .chat-alert-box p {
                    margin: 0 0 15px 0;
                    color: #666;
                    font-size: 16px;
                }

                .chat-alert-box .alert-room-info {
                    background: linear-gradient(135deg, #667eea, #764ba2);
                    color: white;
                    padding: 15px 20px;
                    border-radius: 12px;
                    margin-bottom: 20px;
                }

                .chat-alert-box .alert-room-info .room-name {
                    font-size: 20px;
                    font-weight: 700;
                    margin-bottom: 5px;
                }

                .chat-alert-box .alert-room-info .guest-name {
                    font-size: 14px;
                    opacity: 0.9;
                }

                .chat-alert-box .alert-message-preview {
                    background: #f5f5f5;
                    padding: 12px 15px;
                    border-radius: 10px;
                    margin-bottom: 20px;
                    text-align: left;
                    font-size: 14px;
                    color: #333;
                    max-height: 80px;
                    overflow: hidden;
                }

                .chat-alert-box .btn-respond-chat {
                    background: linear-gradient(135deg, #4CAF50, #388E3C);
                    color: white;
                    border: none;
                    padding: 14px 35px;
                    border-radius: 25px;
                    font-size: 16px;
                    font-weight: 600;
                    cursor: pointer;
                    text-decoration: none;
                    display: inline-block;
                    transition: all 0.3s ease;
                }

                .chat-alert-box .btn-respond-chat:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 5px 20px rgba(76, 175, 80, 0.4);
                    color: white;
                    text-decoration: none;
                }

                .chat-alert-box .btn-dismiss {
                    background: #e0e0e0;
                    color: #666;
                    border: none;
                    padding: 10px 25px;
                    border-radius: 20px;
                    font-size: 14px;
                    cursor: pointer;
                    margin-left: 10px;
                    transition: all 0.3s ease;
                }

                .chat-alert-box .btn-dismiss:hover {
                    background: #bdbdbd;
                }

                /* Floating Chat Badge */
                .chat-notification-badge {
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    background: linear-gradient(135deg, #f44336, #c62828);
                    color: white;
                    padding: 15px 20px;
                    border-radius: 50px;
                    display: none;
                    align-items: center;
                    gap: 10px;
                    cursor: pointer;
                    z-index: 9998;
                    box-shadow: 0 5px 25px rgba(244, 67, 54, 0.4);
                    animation: badgePulse 2s infinite;
                    text-decoration: none;
                }

                .chat-notification-badge:hover {
                    color: white;
                    text-decoration: none;
                    transform: scale(1.05);
                }

                .chat-notification-badge.show {
                    display: flex;
                }

                @keyframes badgePulse {
                    0%, 100% { box-shadow: 0 5px 25px rgba(244, 67, 54, 0.4); }
                    50% { box-shadow: 0 5px 35px rgba(244, 67, 54, 0.6); }
                }

                .chat-notification-badge i {
                    font-size: 20px;
                }

                .chat-notification-badge .count {
                    background: white;
                    color: #f44336;
                    padding: 2px 8px;
                    border-radius: 10px;
                    font-weight: 700;
                    font-size: 14px;
                }
            </style>

            <!-- Alert Overlay -->
            <div class="global-chat-alert" id="globalChatAlert">
                <div class="chat-alert-box">
                    <i class="fas fa-comments alert-icon"></i>
                    <h3>ข้อความใหม่จากแขก!</h3>
                    <p>กรุณาตอบกลับโดยเร็ว</p>
                    <div class="alert-room-info">
                        <div class="room-name" id="alertRoomName">-</div>
                        <div class="guest-name" id="alertGuestName">-</div>
                    </div>
                    <div class="alert-message-preview" id="alertMessagePreview">
                        -
                    </div>
                    <div>
                        <a href="Admin/Chat/ChatManagement.aspx" class="btn-respond-chat">
                            <i class="fas fa-reply"></i> ตอบกลับทันที
                        </a>
                        <button type="button" class="btn-dismiss" onclick="dismissChatAlert()">
                            ปิดชั่วคราว (5 นาที)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Floating Badge -->
            <a href="Admin/Chat/ChatManagement.aspx" class="chat-notification-badge" id="chatNotificationBadge">
                <i class="fas fa-comments"></i>
                <span>แชทใหม่</span>
                <span class="count" id="chatUnreadCount">0</span>
            </a>

            <!-- Audio for notification -->
            <audio id="globalNotificationSound" preload="auto">
                <source src="data:audio/wav;base64,UklGRnoGAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgAZGF0YQoGAACBhYqFbF1sbJaQo5N6YWJ0lJOUlH50ZnKJhZqWlYN0Znd3e4KDmJmXjHlxe3p6f4GGiouJhYB8e35+gIOGiYuKiIaCgYGCgYOFhoaFhYSDgoKCgoKDg4ODg4OCgoKCgoKCgoKCgoKCgoKCgoKCgoKC" type="audio/wav">
            </audio>

            <script>
                // Global Chat Notification System
                var chatAlertInterval = null;
                var chatSoundInterval = null;
                var chatCheckInterval = null;
                var sessionKeepAliveInterval = null;
                var chatAlertDismissedUntil = null;
                var lastKnownUnreadCount = 0;

                // Check for unread messages
                function checkGlobalChatMessages() {
                    // Skip if on ChatManagement page
                    if (window.location.href.indexOf('ChatManagement') > -1) {
                        return;
                    }

                    fetch('<%= ResolveUrl("~/Admin/Chat/ChatManagement.aspx/CheckUnreadMessages") %>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({})
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.d && data.d.hasUnread && data.d.count > 0) {
                            var count = data.d.count;

                            // Update badge
                            var badge = document.getElementById('chatNotificationBadge');
                            var countEl = document.getElementById('chatUnreadCount');
                            if (badge && countEl) {
                                badge.classList.add('show');
                                countEl.innerText = count;
                            }

                            // Show alert if not dismissed and there are new messages
                            var now = new Date().getTime();
                            if ((!chatAlertDismissedUntil || now > chatAlertDismissedUntil) && count > lastKnownUnreadCount) {
                                showGlobalChatAlert(data.d.latestRoom, data.d.latestGuest, data.d.latestMessage || 'ข้อความใหม่');
                            }

                            lastKnownUnreadCount = count;
                        } else {
                            // Hide badge if no unread
                            var badge = document.getElementById('chatNotificationBadge');
                            if (badge) {
                                badge.classList.remove('show');
                            }
                            hideGlobalChatAlert();
                            lastKnownUnreadCount = 0;
                        }
                    })
                    .catch(err => console.log('Chat check error:', err));
                }

                // Show alert
                function showGlobalChatAlert(roomName, guestName, message) {
                    document.getElementById('alertRoomName').innerText = roomName || '-';
                    document.getElementById('alertGuestName').innerText = guestName || '-';
                    document.getElementById('alertMessagePreview').innerText = message || '-';
                    document.getElementById('globalChatAlert').classList.add('show');

                    // Play sound
                    playGlobalChatSound();

                    // Repeat sound every 3 seconds
                    if (!chatSoundInterval) {
                        chatSoundInterval = setInterval(playGlobalChatSound, 3000);
                    }
                }

                // Hide alert
                function hideGlobalChatAlert() {
                    document.getElementById('globalChatAlert').classList.remove('show');
                    if (chatSoundInterval) {
                        clearInterval(chatSoundInterval);
                        chatSoundInterval = null;
                    }
                }

                // Dismiss alert for 5 minutes
                function dismissChatAlert() {
                    hideGlobalChatAlert();
                    chatAlertDismissedUntil = new Date().getTime() + (5 * 60 * 1000); // 5 minutes
                }

                // Play sound
                function playGlobalChatSound() {
                    try {
                        var audio = document.getElementById('globalNotificationSound');
                        if (audio) {
                            audio.currentTime = 0;
                            audio.play().catch(e => {});
                        }
                    } catch(e) {}
                }

                // Session Keep-Alive
                function keepSessionAlive() {
                    fetch('<%= ResolveUrl("~/Admin/Chat/ChatManagement.aspx/KeepAlive") %>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({})
                    })
                    .then(response => response.json())
                    .catch(err => console.log('Keep-alive error:', err));
                }

                // Initialize on page load
                document.addEventListener('DOMContentLoaded', function() {
                    // Check for new messages every 5 seconds
                    checkGlobalChatMessages();
                    chatCheckInterval = setInterval(checkGlobalChatMessages, 5000);

                    // Keep session alive every 5 minutes
                    sessionKeepAliveInterval = setInterval(keepSessionAlive, 5 * 60 * 1000);
                });

                // Cleanup on page unload
                window.addEventListener('beforeunload', function() {
                    if (chatCheckInterval) clearInterval(chatCheckInterval);
                    if (chatSoundInterval) clearInterval(chatSoundInterval);
                    if (sessionKeepAliveInterval) clearInterval(sessionKeepAliveInterval);
                });
            </script>
        </asp:Panel>
    </form>
</body>
</html>